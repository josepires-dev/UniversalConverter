flowchart LR
    Browser[Local browser] --> UI[index.php + app.js]
    UI --> Formats[api/formats.php]
    UI --> Convert[api/convert.php]
    Convert --> Router{Input type}
    Router --> Image[ImageMagick]
    Router --> Media[FFmpeg]
    Router --> Docs[Pandoc / text converters]
    Router --> URL[URL fetcher with SSRF protection]
    Image --> Temp[(storage/tmp)]
    Media --> Temp
    Docs --> Temp
    URL --> Temp
    Temp --> Download[Download and immediate cleanup]
