Options -Indexes

<FilesMatch "^(config\.php|README\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>
